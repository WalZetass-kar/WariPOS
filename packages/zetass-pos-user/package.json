{
  "name": "zetass-pos-user",
  "version": "2.0.0",
  "description": "Zetass Pos - Point of Sale Application for Users",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "Zetass",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "build": "npm run build:electron && npm run build:vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop:windows": "npm run build && electron-builder --win --publish never",
    "build:desktop:linux": "npm run build && electron-builder --linux --publish never",
    "build:desktop:mac": "npm run build && electron-builder --mac --publish never",
    "build:android": "npm run build:vite && npx cap sync android",
    "build:ios": "npm run build:vite && npx cap sync ios",
    "android:release": "npm run build:vite && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run build:vite && npx cap sync android && cd android && ./gradlew bundleRelease",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@zetass/pos-shared-lib": "workspace:*",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-table": "^9.3.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.5.2",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "midtrans-client": "^1.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "react-to-print": "^3.3.0",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.zetass.pos.user",
    "productName": "Zetass Pos",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    }
  }
}
