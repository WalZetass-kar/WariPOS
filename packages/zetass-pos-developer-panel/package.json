{
  "name": "zetass-pos-developer-panel",
  "version": "2.0.0",
  "description": "Zetass Pos Developer Panel - License & System Management",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "Zetass",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && npm run build:electron && electron .",
    "build": "npm run build:electron && npm run build:vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop:windows": "npm run build && electron-builder --win --publish never",
    "build:desktop:linux": "npm run build && electron-builder --linux --publish never",
    "build:desktop:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@zetass/pos-shared-lib": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.zetass.pos.developer",
    "productName": "Zetass Pos Developer Panel",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    }
  }
}
