{
  "name": "waripos",
  "version": "1.0.4",
  "description": "WariPOS - Desktop & Mobile Point of Sale Application",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "WariPOS",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "predev": "node scripts/ensure-native-deps.cjs",
    "dev:desktop": "npm run dev",
    "dev:mobile": "npm run dev:vite -- --host 0.0.0.0",
    "dev:license": "npm --prefix license-server run dev",
    "dev:with-license": "concurrently -k \"npm run dev:license\" \"npm run dev\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch",
    "dev:watch": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron:watch\" \"sleep 3 && wait-on http://localhost:5173 && electron .\"",
    "build": "npm run verify:build-resources && npm run rebuild:electron && npm run build:electron && npm run build:vite && electron-builder",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-main.cjs && node scripts/copy-electron-assets.cjs",
    "verify:build-resources": "node scripts/verify-build-resources.cjs",
    "build:desktop": "npm run verify:build-resources && npm run rebuild:electron && npm run build:electron && npm run build:vite",
    "build:desktop:windows": "npm run desktop:win:installer",
    "build:desktop:linux": "npm run desktop:linux",
    "build:desktop:mac": "npm run desktop:mac",
    "build:win": "npm run build:desktop:windows",
    "build:linux": "npm run build:desktop:linux",
    "build:mac": "npm run build:desktop:mac",
    "mobile:sync:android": "npm run verify:build-resources && npm run build:vite && npx cap sync android",
    "build:android": "npm run build:mobile:android",
    "build:ios": "npm run verify:build-resources && npm run build:vite && npx cap sync ios",
    "build:mobile:android": "npm run android:release && npm run android:aab",
    "build:mobile:ios": "npm run build:ios",
    "sync:test": "node scripts/sync-test.cjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run mobile:sync:android && node scripts/build-android.cjs assembleDebug",
    "prepare:android-network-security": "node scripts/prepare-android-network-security.cjs",
    "prepare:android-signing": "node scripts/prepare-android-signing.cjs",
    "android:release": "npm run verify:build-resources && npm run build:vite && npm run prepare:android-network-security && npx cap sync android && npm run prepare:android-signing && node scripts/build-android.cjs assembleRelease",
    "android:aab": "npm run verify:build-resources && npm run build:vite && npm run prepare:android-network-security && npx cap sync android && npm run prepare:android-signing && node scripts/build-android.cjs bundleRelease",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:ios",
    "ios:open": "npx cap open ios",
    "ios:doctor": "npx cap doctor ios",
    "mobile:android:debug": "npm run android:debug",
    "mobile:android:release": "npm run android:release",
    "mobile:android:aab": "npm run android:aab",
    "mobile:ios:sync": "npm run ios:sync",
    "desktop:win": "npm run build:desktop && electron-builder --win zip --publish never",
    "desktop:win:installer": "node scripts/build-windows.cjs",
    "desktop:win:all": "npm run build:desktop && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "lint": "eslint src tests",
    "qa:stress": "ELECTRON_RUN_AS_NODE=1 electron scripts/qa-stress.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "desktop:linux": "npm run build:desktop && electron-builder --linux --publish never",
    "desktop:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "desktop:all:ci": "npm run build:desktop && electron-builder --win --linux --mac --publish never",
    "postinstall": "npm run rebuild:node",
    "release:patch": "npm version patch --no-git-tag-version && npm run release:tag",
    "release:minor": "npm version minor --no-git-tag-version && npm run release:tag",
    "release:major": "npm version major --no-git-tag-version && npm run release:tag",
    "release:tag": "node scripts/sync-version.cjs && git add -A && git commit -m \"chore: release v$(node -p 'require(./package.json').version')\" && git tag v$(node -p 'require(./package.json').version') && git push origin main --tags",
    "release:changelog": "node scripts/generate-changelog.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.8.3",
    "@emotion/is-prop-valid": "^1.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/electron": "^8.2.0",
    "@sentry/react": "^11.8.0",
    "@supabase/auth-js": "^2.118.0",
    "@supabase/functions-js": "^2.118.0",
    "@supabase/postgrest-js": "^2.118.0",
    "@supabase/realtime-js": "^2.118.0",
    "@supabase/storage-js": "^2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bindings": "^1.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "file-uri-to-path": "^2.0.0",
    "framer-motion": "^14.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.5.2",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "midtrans-client": "^1.4.3",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.wari.pos",
    "productName": "WariPOS",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      },
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "WariPOS",
        "schemes": [
          "waripos",
          "zetasspos"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "node_modules/**/*.node"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "WalZetass-kar",
      "repo": "WariPOS",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "maintainer": "WariPOS",
      "icon": "build/icon.png",
      "desktop": {
        "Name": "WariPOS",
        "Comment": "WariPOS Desktop Point of Sale Application",
        "Categories": "Office;Finance;",
        "Keywords": "pos;point-of-sale;cashier;retail;"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WariPOS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WariPOS"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
