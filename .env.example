# ─── Supabase (License server + sinkronisasi cloud) ───
# Wajib diisi agar fitur lisensi dan sinkronisasi cloud aktif.
# Tidak ada nilai bawaan di dalam kode sumber.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_LICENSE_SERVER_URL=https://YOUR_PROJECT.supabase.co/functions/v1/mediasoft-license

# ─── Firebase (Development) ───
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

VITE_API_BASE_URL=
VITE_AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
VITE_LICENSE_ADMIN_EMAIL=admin@waripos.local
VITE_REQUIRE_PRODUCTION_ENDPOINTS=false
VITE_CERT_PIN_SHA256=47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=
VITE_LICENSE_OFFLINE_GRACE_HOURS=720

# Secret lokal untuk mengenkripsi token lisensi yang tersimpan di database.
# Dibuat otomatis dengan: openssl rand -hex 32
# ZETASS_POS_LOCAL_SECRET=

# Aktifkan Firebase Emulator (localhost) saat development.
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
